# BranchWise AI — environment template (do not commit real secrets)
# Copy values into `.env.local` manually (do not commit `.env.local`).

# Supabase (already used by the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for `/api/auth/login` and `getSession()` — read `public.users` with RLS bypass
SUPABASE_SERVICE_ROLE_KEY=

# Required for JWT cookie signing (`bw_session`)
JWT_SECRET=

# Upstash Redis — login rate limiting (5 attempts per IP per 15 minutes on `/api/auth/login`)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Login email OTP (Resend) — required in production for employee sign-in
RESEND_API_KEY=
RESEND_FROM_EMAIL=BranchWise AI <noreply@yourdomain.com>

# Public app URL for links (onboarding invites, emails, cron). Required in production.
# Local dev: omit to auto-use http://localhost:3000 from the browser request.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Vercel Cron / external scheduler — Bearer token for /api/cron/* routes
CRON_SECRET=

# Optional: GM/HR report AI summaries (POST /api/reports/[id]/ai-summary)
OPENAI_API_KEY=

# Google Places API (optional Fallback) — primär im Super-Admin-Bereich → Integrationen (Datenbank)
# GOOGLE_PLACES_API_KEY=

# Demo-Bewertungen in Entwicklung (true) — Live nur mit API-Key + gespeichertem Filial-Link
# GOOGLE_REVIEWS_USE_MOCK=true

# GM Frühstück — breakfast-order Supabase (read-only via API, same style as BranchWise)
# breakfast-order → Settings → API → Project URL + service_role secret
BREAKFAST_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
BREAKFAST_SUPABASE_SERVICE_ROLE_KEY=

# Legacy breakfast HTTP integration (optional; used by sync/link scripts)
BREAKFAST_API_BASE_URL=
BREAKFAST_INTEGRATION_TOKEN=

# Vercel / corporate SSL (optional; only if Supabase TLS fails in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0
